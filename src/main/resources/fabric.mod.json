{
  "schemaVersion": 1,
  "id": "todo",
  "version": "${version}",

  "name": "Simple Todo List",
  "description": "A simple todo list GUI for BTA!",
  "authors": [
    "Cookie Cakes"
  ],
  "contact": {
    "sources": "https://github.com/FatherCheese/todo-list",
		"issues": "https://github.com/FatherCheese/todo-list/issues"
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
		"client": [
			"cookie.todo.TodoClient"
		],
		"beforeClientStart": [
			"cookie.todo.TodoClient"
		],
		"afterClientStart": [
			"cookie.todo.TodoClient"
		]
	},
  "mixins": [
		"todo.mixins.json"
  ],

  "depends": {
		"minecraft": "*",
    "fabricloader": ">=0.15.5"
  },
  "suggests": {
  }
}
